<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="accent">#2D6A4F</color>
    <color name="accent_dark">#1B4332</color>
    <color name="screen">#F2F5F3</color>
    <color name="card">#FFFFFF</color>
    <color name="text">#1F2421</color>
    <color name="muted">#6B7A72</color>
    <color name="error_background">#FDECEA</color>
    <color name="error_text">#B3261E</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/screen</item>
    </style>

    <style name="Card">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/accent_dark</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
